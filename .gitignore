__pycache__/

# What pip writes into clients/python when it builds the package there.
clients/python/build/
clients/python/*.egg-info/

# What npm and tsc write into clients/typescript when it is built there.
clients/typescript/node_modules/
clients/typescript/dist/

# Local credential files, so one is never committed by accident.
.env
.env.*
!.env.example
secrets.json
*.pem
*.key
